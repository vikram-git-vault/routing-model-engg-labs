GEMINI_API_KEY=your-gemini-api-key
GENAI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=your-anthropic-api-key

LLM_TEMPERATURE=0.1

# Tiered router: these must differ, or the tier routing does nothing.
# Quota is per model, so two models = two daily budgets.
GENAI_MODEL_SMALL=gemini-3.5-flash-lite
GENAI_MODEL_LARGE=gemini-3.6-flash

# Per-attempt request deadline in seconds. API minimum is 10.
LLM_TIMEOUT_SECONDS=20
